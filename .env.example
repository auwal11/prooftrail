# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string
DATABASE_URL="postgresql://prooftrail:prooftrail@localhost:5432/prooftrail?schema=public"

# Public origin used for absolute links (no trailing slash)
APP_URL="http://localhost:3000"

# Directory for private evidence and report files. Must NOT be inside public/.
STORAGE_DIR="./var/storage"

# Max upload size in bytes (default 10 MiB)
MAX_UPLOAD_BYTES=10485760

# Optional: allow OCR to download language data instead of using bundled data
# OCR_LANG_PATH="./assets/tessdata"
